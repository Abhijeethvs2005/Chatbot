# Option A: Local Docker PostgreSQL (Default)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChooseAStrongPassword123!
POSTGRES_DB=rag_db

# Option B: Cloud PostgreSQL (e.g. Neon Serverless Postgres, Supabase, AWS RDS)
# If set, the backend connects directly to this cloud database instead of the local container.
# DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-hostname>/neondb?ssl=require

# OpenAI API Key
OPENAI_API_KEY=sk-proj-YourProductionKeyHere

# Optional Model Overrides
# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini
